# Local development defaults work with a local PostgreSQL database named aicoderoom_dev.
AICODEROOM_DATABASE_URL=postgresql:///aicoderoom_dev
AICODEROOM_HOST=127.0.0.1
AICODEROOM_PORT=8788

# Comma-separated renderer origins. The packaged desktop app uses app://renderer.
AICODEROOM_ALLOWED_ORIGINS=app://renderer,http://127.0.0.1:5173,http://localhost:5173
